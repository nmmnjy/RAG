{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-frame-options",
          "value": "DENY"
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        }
      ]
    }
  ]
}

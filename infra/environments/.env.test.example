APP_ENV=test

# Frontend (Vercel Preview)
NEXT_PUBLIC_APP_ENV=test
NEXT_PUBLIC_API_BASE_URL=https://api-test.example.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_TEST_ANON_KEY

# Backend (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2
CORS_ALLOW_ORIGINS=https://test.example.com
DB_URL=postgresql://postgres:password@db.test.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
SUPABASE_KEY=YOUR_TEST_SERVICE_ROLE_KEY

# Model providers
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=YOUR_TEST_OPENAI_KEY

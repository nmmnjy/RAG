APP_ENV=test
APP_PORT=8000
API_VERSION=v1
LOG_LEVEL=INFO

# 00 基线最小集合
DB_URL=postgresql://postgres:password@localhost:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
LLM_API_KEY=YOUR_LLM_API_KEY
EMBEDDING_MODEL=text-embedding-3-small

# 03 向量化 real 配置
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_PROVIDER_ENABLE_REAL=true
EMBEDDING_PROVIDER_FALLBACK_TO_MOCK=false
VECTOR_REPOSITORY=in_memory
VECTOR_REPOSITORY_ENABLE_REAL=false
VECTOR_REPOSITORY_FALLBACK_TO_IN_MEMORY=true

# 05 答案生成 real 配置
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_ENABLE_REAL=true
LLM_PROVIDER_FALLBACK_TO_MOCK=false
